{
  "name": "patrick-ai-agent",
  "version": "1.0.2",
  "description": "PatrickAI Agent — Clean-room desktop implementation of Claude Code architecture (Workbench + Coordinator Swarm + KAIROS/Dream Daemon)",
  "author": "vtherLiang",
  "homepage": "https://github.com/vtherLiang/patrickAI_agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/vtherLiang/patrickAI_agent.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:all": "electron-vite build && electron-builder --mac --win"
  },
  "build": {
    "appId": "com.patrickai.agent",
    "productName": "PatrickAI Agent",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "PatrickAI-Agent-mac-${arch}-${version}.${ext}"
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "PatrickAI-Agent-win-${arch}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "PatrickAI-Agent-Windows-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "vtherLiang",
      "repo": "patrickAI_agent"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.460.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
